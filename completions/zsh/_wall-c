#compdef wall-c

_wall_c() {
  _arguments -s \
    '-m[Target MAC address]:mac address:' \
    '--mac[Target MAC address]:mac address:' \
    '-b[Broadcast IPv4 address]:broadcast ip:_guard "[0-9.]#" "IPv4 address"' \
    '--broadcast[Broadcast IPv4 address]:broadcast ip:_guard "[0-9.]#" "IPv4 address"' \
    '--interface[Resolve broadcast from interface]:interface:_net_interfaces' \
    '-p[Destination UDP port]:port:_guard "[0-9]#" "port (1-65535)"' \
    '--port[Destination UDP port]:port:_guard "[0-9]#" "port (1-65535)"' \
    '--count[Repeat sends]:count:_guard "[0-9]#" "repeat count"' \
    '--interval-ms[Delay between repeats]:milliseconds:_guard "[0-9]#" "milliseconds"' \
    '--dry-run[Validate and print without sending]' \
    '--quiet[Reduce normal output]' \
    '--smart[Skip send if host appears awake and verify wake after send]' \
    '--yes[Skip confirmation prompt]' \
    '--version[Show version information]' \
    '-y[Skip confirmation prompt]' \
    '-h[Show help message]'
}

_wall_c "$@"
