#compdef wall-c

# zsh completion for wall-c
#
# Supports the current short options exposed by the CLI:
#   -m <mac>, -b <broadcast_ip>, -p <port>, -y, -h

_wall_c_macs_from_config() {
  local cfg

  if [[ -n "$XDG_CONFIG_HOME" ]]; then
    cfg="$XDG_CONFIG_HOME/wall-c/config"
  else
    cfg="$HOME/.config/wall-c/config"
  fi

  [[ -r "$cfg" ]] || return 0

  # Offer non-empty, non-comment lines from config as MAC candidates.
  _values 'configured macs' ${(f)"$(sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$cfg")"}
}

_wall_c() {
  _arguments -s \
    '-m[Target MAC address]:mac address:_wall_c_macs_from_config' \
    '-b[Broadcast IPv4 address]:broadcast ip:_guard "[0-9.]#" "IPv4 address"' \
    '-p[Destination UDP port]:port:_guard "[0-9]#" "port (1-65535)"' \
    '-y[Skip confirmation prompt]' \
    '-h[Show help message]'
}

_wall_c "$@"
